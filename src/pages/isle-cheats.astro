---
import BaseLayout from '../layouts/BaseLayout.astro'
import { GameProductPage } from '../views/GameProductPage'
import { SEO, SITE_NAME, SITE_URL } from '../data/site'
import { PRODUCT_PAGE_FAQS } from '../data/faqs'
import { faqPageJsonLd } from '../lib/seo'
import { getGameImage } from '../data/images'

const jsonLdExtra = [
  {
    '@type': 'Product',
    name: 'The Isle Cheats',
    description: SEO.product.description,
    brand: { '@type': 'Brand', name: SITE_NAME },
    url: `${SITE_URL}${SEO.product.path}`,
    image: getGameImage('isle'),
    category: 'The Isle Evrima Cheats',
    about: {
      '@type': 'VideoGame',
      name: 'The Isle',
      alternateName: 'The Isle Evrima',
    },
    additionalProperty: [
      {
        '@type': 'PropertyValue',
        name: 'Scope',
        value: 'The Isle only â€” no other games',
      },
    ],
    offers: {
      '@type': 'Offer',
      url: `${SITE_URL}${SEO.product.path}`,
      availability: 'https://schema.org/InStock',
      priceCurrency: 'USD',
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Blogs', item: `${SITE_URL}/articles` },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'The Isle Cheats',
        item: `${SITE_URL}/isle-cheats`,
      },
    ],
  },
  faqPageJsonLd(PRODUCT_PAGE_FAQS, `${SITE_URL}/isle-cheats`),
]
---

<BaseLayout seo={SEO.product} jsonLdExtra={jsonLdExtra}>
  <GameProductPage client:idle guideSlug="isle-cheats" />
</BaseLayout>


