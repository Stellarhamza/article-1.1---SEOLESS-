---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SupportPage } from '../views/SupportPage'
import { SEO, SITE_NAME, SITE_PURPOSE, SITE_URL } from '../data/site'
import { SUPPORT_FAQS } from '../data/support'
import { faqPageJsonLd } from '../lib/seo'

const jsonLdExtra = [
  {
    '@type': 'ContactPage',
    '@id': `${SITE_URL}/support#contactpage`,
    url: `${SITE_URL}/support`,
    name: SEO.support.title,
    description: SEO.support.description,
    about: {
      '@type': 'Thing',
      name: SITE_NAME,
      description: SITE_PURPOSE,
    },
    inLanguage: 'en',
    isPartOf: { '@id': `${SITE_URL}/#website` },
  },
  faqPageJsonLd(SUPPORT_FAQS, `${SITE_URL}/support`),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Support', item: `${SITE_URL}/support` },
    ],
  },
]
---

<BaseLayout seo={SEO.support} jsonLdExtra={jsonLdExtra}>
  <SupportPage client:visible />
</BaseLayout>


